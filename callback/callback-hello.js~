const fs = require('fs');

fs.readFile('input.txt', 'utf8', (err, data) => {
    if (err) {
        console.error("Error: " + err);
        return
    }
    const modifiedData = data.toUpperCase();
    fs.writeFile('output.txt', modifiedData, (err) => {
        if (err) {
            console.error("Error: " + err);
            return
        }
        console.log("File written successfully");
    });
});